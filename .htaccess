# === Correct content types for self-hosted fonts and agent files ===
# /fonts and /vendor hold the self-hosted Inter + Font Awesome fonts; llms.txt,
# /.well-known/ard.json and /agent-skills/*.md are the AI-agent discovery files.
AddType font/woff2 .woff2
AddType font/ttf .ttf
AddType text/markdown .md
AddCharset UTF-8 .txt .md .json

# === Performance: compression ===
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
    AddOutputFilterByType DEFLATE text/markdown font/ttf
</IfModule>

# === Performance: browser caching for static assets ===
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Basic hardening headers: no MIME sniffing, no framing by other sites, and
    # only the origin (not the full URL) sent to other sites. No effect on SEO or speed.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # Agent discovery files change rarely but must never be stuck for a year.
    <FilesMatch "^(llms\.txt|ard\.json|SKILL\.md)$">
        Header set Cache-Control "public, max-age=3600"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    # The fonts are fetched with CORS (preload crossorigin), so allow it explicitly.
    <FilesMatch "\.(woff2?|ttf)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# === Missing pages: handled by not-found.php ===
# Any URL that doesn't match a real file or route goes to not-found.php,
# which (1) applies any redirect set up in admin -> SEO -> Redirects,
# (2) logs the miss for admin -> SEO -> 404 Errors, and (3) then, by
# default, sends the visitor to the homepage exactly as before -- or shows a
# real 404 page if "Unmatched 404" is switched to that in Site Settings.
# This only fires for genuine server-level 404s -- the dedicated "Not Found"
# pages blog-post.php and case-study.php render for an unknown slug are full
# responses those scripts generate themselves, so they're unaffected (they
# still honour redirects, through header.php).
ErrorDocument 404 /not-found.php

# === Security: block direct download of the raw SQL import file ===
# database.sql only needs to exist here long enough to import through
# phpMyAdmin -- leaving it downloadable would expose the schema and the
# default admin password hash to anyone who requests the URL directly.
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# === Clean URLs: serve every page without its .php extension ===
# /about.php -> /about, /blog-post.php?slug=x -> /blog-post?slug=x, etc.
# The admin panel (admin/) is deliberately excluded -- it's not indexed by
# search engines, and its own internal links are relative .php references
# that don't need to change.
<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews

    # -2) Block access to .git and other dotfiles (defense in depth). The
    #     deploy workflow also excludes .git from upload, but this blocks it
    #     at the web server level too in case it (or any other dotfile)
    #     ever lands here.
    RewriteCond %{REQUEST_URI} /\.(git|github|gitignore)
    RewriteRule .* - [F,L]

    # -1) Force HTTPS site-wide, admin panel included -- the admin login form
    #     posts a username/password and every request afterward carries the
    #     session cookie, neither of which should ever be able to travel over
    #     plain HTTP. Placed first so every rule below it always operates on
    #     the https:// URL space.
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # -0.5) The site is canonically served from the apex domain -- redirect
    #       any www. request to the same path on the non-www domain, so
    #       www.wsdigitalmarketing.com.au never exists as a second,
    #       duplicate-content copy of the site.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # 0) The homepage is canonically "/" -- collapse both "/index" and
    #    "/index.php" straight to it instead of leaving "/index" as a second,
    #    duplicate-content URL for the same page.
    RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # 0.5) Blog posts are canonically /blog/<slug> -- collapse the older
    #      /blog-post.php?slug=x and /blog-post?slug=x forms straight there
    #      in one hop (placed ahead of the generic .php-stripping rule below,
    #      which would otherwise catch the .php variant first).
    RewriteCond %{THE_REQUEST} \s/+blog-post(\.php)?\?slug=([^\s&]+)[\s&] [NC]
    RewriteRule ^ /blog/%2? [R=301,L]

    # 0.7) Alternate/shorter URLs people search for or might type directly,
    #      redirected to the real service page so they don't 404 and so any
    #      external links/search listings consolidate onto the one real URL.
    RewriteRule ^web-design/?$ /website-development [R=301,L]
    RewriteRule ^ppc/?$ /ppc-advertising [R=301,L]

    # 1) A browser that actually requests a URL ending in .php gets sent to
    #    the same URL minus .php, permanently (301) so bookmarks and search
    #    engines update. THE_REQUEST is the raw request line as the browser
    #    sent it, so this only matches real incoming requests -- never the
    #    internal rewrite in step 2 below, which avoids a redirect loop.
    #    cache-reset.php is also excluded: this redirect drops the query
    #    string, which silently stripped its ?token=... (deploy.yml calls
    #    it by its real .php name on purpose so it never hits this rule).
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{REQUEST_URI} !^/cache-reset\.php
    RewriteCond %{THE_REQUEST} \s/+(.*)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 2) Internally serve the matching .php file for a clean-URL request,
    #    without changing what's shown in the browser's address bar. Only
    #    fires when the clean path isn't already a real file/directory and
    #    a matching .php file actually exists, so 404s and static assets
    #    (css/, js/, images/) are completely unaffected.
    #
    #    Uses %{DOCUMENT_ROOT}%{REQUEST_URI} rather than %{REQUEST_FILENAME}
    #    deliberately: for a nonexistent multi-segment path like
    #    /blog/some-slug, Apache's own filename translation resolves
    #    REQUEST_FILENAME down to just ".../blog" (silently dropping
    #    "/some-slug" as if it were PATH_INFO on a script named "blog"),
    #    even though "blog" itself doesn't exist either. That truncated
    #    value then wrongly matched "blog.php" here and produced a
    #    self-amplifying rewrite (blog -> blog.php -> blog.php.php -> ...)
    #    until Apache's internal-redirect limit killed the request with a
    #    500. REQUEST_URI is the literal request path with no such
    #    filesystem-based reinterpretation, so this can't happen.
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-d
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f
    RewriteRule ^(.+)$ $1.php [L]

    # 2.5) /sitemap.xml is generated live by sitemap.php (static pages plus
    #      every case study and published blog post straight from the
    #      database), served under the conventional sitemap.xml name search
    #      engines expect rather than the .php extension.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 2.6) /robots.txt is generated by robots.php from the text saved in
    #      admin -> SEO -> Robots.txt. No "file doesn't exist" condition on
    #      purpose, so a leftover static robots.txt can never shadow it.
    RewriteRule ^robots\.txt$ robots.php [L]

    # 2.7) /llms.txt -- the Markdown guide to this site for AI assistants and
    #      answer engines (llmstxt.org format) -- is generated by llms.php so
    #      new case studies and blog posts are listed automatically.
    RewriteRule ^llms\.txt$ llms.php [L]

    # 3) Serve /blog/<slug> from blog-post.php?slug=<slug> internally. Placed
    #    after rule 2 (which never matches this path anyway, since no
    #    literal "blog/<slug>.php" file exists) so it reads as the next step
    #    in the same numbered sequence.
    RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L,QSA]

    # 4) Same pattern for case study detail pages: /case-studies/<slug> is
    #    served from case-study.php?slug=<slug> (singular filename, so it
    #    can never collide with case-studies.php, the listing page itself).
    RewriteRule ^case-studies/([^/]+)/?$ case-study.php?slug=$1 [L,QSA]
</IfModule>
